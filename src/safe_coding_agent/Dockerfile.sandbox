# Sandbox image for running model-written code and its tests.
# Build with:  sca sandbox build      (add packages: sca sandbox build --package numpy)
ARG BASE=python:3.12-slim
FROM ${BASE}
ARG EXTRA=""
RUN pip install --no-cache-dir "pytest>=7" ${EXTRA} \
 && useradd --uid 10001 --create-home sandbox
USER 10001
WORKDIR /work
